# Porta do servidor (Railway define automaticamente)
PORT=3000

# Fuso horário
TZ=America/Sao_Paulo

# Caminho do banco de dados (use volume persistente no Railway)
DB_PATH=./data/pendencias.db

# Caminho da sessão do WhatsApp (IMPORTANTE: volume persistente no Railway)
WWEBJS_AUTH_PATH=./wwebjs_auth

# Caminho dos comprovantes
UPLOADS_DIR=./public/uploads

# Executável do Chrome (Railway/Linux — veja nixpacks.toml)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
