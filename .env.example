# Porta do servidor (Railway define automaticamente)
PORT=3000

# Fuso horário
TZ=America/Sao_Paulo

# Caminho do banco de dados (use volume persistente no Railway)
DB_PATH=./data/pendencias.db

# Caminho da sessão do WhatsApp (IMPORTANTE: volume persistente no Railway)
WWEBJS_AUTH_PATH=./wwebjs_auth

# Caminho dos comprovantes
UPLOADS_DIR=./public/uploads

# Executável do Chrome (Railway/Linux — veja nixpacks.toml)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# Google Sheets - ID da planilha (extrair da URL)
GOOGLE_SHEET_ID=1RCqibwPE8xSrZ7tK17XWST9hadwlLRykz4geju70YCg

# Google Service Account - Caminho para credenciais JSON
GOOGLE_SERVICE_ACCOUNT_PATH=./google-credentials.json

# API Claude (para relatórios inteligentes)
# Atualizar no Railway: Settings → Variables
ANTHROPIC_API_KEY=sk-ant-api03-xxx...
